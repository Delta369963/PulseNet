# .gitignore - generated by Antigravity
# General OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/
venv/
__pycache__/

# Build directories
dist/
build/
out/

# IDE / editor directories & files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.code-workspace

# MacOS specific
*.DS_Store
.AppleDouble
.LSOverride

# Environment files
.env
.env.*

# Misc
*.pid
*.seed
*.tmp

# Package lock files (optional)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Coverage reports
coverage/
.nyc_output/

# Public key files
*.pem
*.key
